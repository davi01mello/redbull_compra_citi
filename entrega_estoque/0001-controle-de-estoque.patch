+:root {
+  --bg: #070d16;
+  --surface: #101a26;
+  --surface-2: #131f2d;
+  --surface-soft: #0c1520;
+  --green: #32e968;
+  --green-pressed: #27cc59;
+  --green-soft: rgba(50, 233, 104, .12);
+  --red: #ff5c5c;
+  --red-soft: rgba(255, 92, 92, .12);
+  --amber: #ffc845;
+  --amber-soft: rgba(255, 200, 69, .12);
+  --blue: #6aa8ff;
+  --blue-soft: rgba(106, 168, 255, .12);
+  --text: #ffffff;
+  --muted: #b6bdc8;
+  --faint: #7d8898;
+  --border: #344152;
+  --border-soft: #233041;
+  --disabled: #526070;
+  --radius: 18px;
+  --shadow: 0 18px 50px rgba(0, 0, 0, .28);
+}
+
+* { box-sizing: border-box; }
+html { min-width: 320px; background: var(--bg); }
+body {
+  margin: 0;
+  min-height: 100vh;
+  background: radial-gradient(circle at 50% -15%, rgba(50, 233, 104, .07), transparent 38rem), var(--bg);
+  color: var(--text);
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  -webkit-font-smoothing: antialiased;
+}
+button, input, textarea { font: inherit; color: inherit; }
+button { -webkit-tap-highlight-color: transparent; cursor: pointer; }
+svg { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
+.hidden { display: none !important; }
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
+.muted { color: var(--muted); }
+.small { font-size: 12px; }
+.eyebrow { margin: 0 0 6px; color: var(--green); font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
+h1 span, h2 span { color: var(--green); }
+:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
+
+/* Botões ------------------------------------------------------------------ */
+.primary-button {
+  position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
+  min-height: 50px; padding: 0 22px; border: 0; border-radius: 14px;
+  background: var(--green); color: #04110a; font-weight: 800;
+  transition: background .2s, transform .1s;
+}
+.primary-button:hover:not(:disabled) { background: var(--green-pressed); }
+.primary-button:active:not(:disabled) { transform: scale(.98); }
+.primary-button:disabled { background: var(--disabled); color: #c7ced8; cursor: not-allowed; }
+.primary-button.danger { background: var(--red); color: #1a0505; }
+.primary-button.danger:hover:not(:disabled) { background: #f04848; }
+.button-loader { display: none; width: 18px; height: 18px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin .7s linear infinite; }
+.loading .button-loader { display: inline-block; }
+.loading .button-label { opacity: .6; }
+@keyframes spin { to { transform: rotate(360deg); } }
+
+.ghost-button {
+  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
+  min-height: 42px; padding: 0 16px; border: 1px solid var(--border); border-radius: 12px;
+  background: transparent; color: var(--text); font-weight: 600; font-size: 14px;
+  transition: border-color .2s, background .2s;
+}
+.ghost-button svg { width: 18px; height: 18px; }
+.ghost-button:hover { border-color: #526174; background: rgba(255, 255, 255, .03); }
+.ghost-button.wide { width: 100%; margin-top: 10px; }
+.icon-button { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--border); border-radius: 12px; background: transparent; }
+.icon-button svg { width: 20px; height: 20px; }
+
+/* Inputs ------------------------------------------------------------------ */
+.input-wrap { position: relative; margin-bottom: 14px; }
+.input-wrap svg { position: absolute; top: 15px; left: 15px; width: 20px; color: var(--muted); }
+.input-wrap input { padding-left: 46px !important; }
+input, textarea {
+  width: 100%; min-height: 50px; padding: 0 14px;
+  border: 1px solid var(--border); border-radius: 14px; outline: 0;
+  background: var(--surface-soft); transition: border-color .2s, box-shadow .2s;
+}
+textarea { min-height: 64px; padding: 12px 14px; resize: vertical; }
+input::placeholder, textarea::placeholder { color: #778393; }
+input:focus, textarea:focus { border-color: var(--green); box-shadow: 0 0 0 3px var(--green-soft); }
+input[aria-invalid="true"], textarea[aria-invalid="true"] { border-color: var(--red); box-shadow: 0 0 0 3px var(--red-soft); }
+label { display: inline-block; margin: 0 0 8px 2px; font-size: 14px; font-weight: 700; }
