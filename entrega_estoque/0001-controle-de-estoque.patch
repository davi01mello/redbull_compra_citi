+++ b/scripts/export_stock_schema_sql.py
@@ -0,0 +1,57 @@
+"""Regera sql/estoque_schema.sql a partir da migration c3f8a1d27b54.
+
+    python -m scripts.export_stock_schema_sql
+
+O arquivo SQL é a mesma lista de comandos da migration, para revisão e
+aplicação manual. tests/test_stock_schema_sql.py falha se os dois divergirem.
+"""
+
+import importlib.util
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+MIGRATION = ROOT / "app/db/migrations/versions/c3f8a1d27b54_add_stock_control_ledger.py"
+OUTPUT = ROOT / "sql/estoque_schema.sql"
+
+HEADER = """-- =====================================================================
+-- Controle de estoque Red Bull CITi — modelo de dados (PostgreSQL 11+)
+--
+-- Mesmo conteúdo da revisão Alembic c3f8a1d27b54 (parte de 7e03d1bf5a42).
+-- Caminho recomendado:  alembic upgrade head
+-- Este arquivo existe para revisão, diagramas (DBeaver/pgAdmin) e para
+-- quem precisar aplicar o modelo manualmente. É idempotente: pode ser
+-- executado de novo sem erro, e o `alembic upgrade head` posterior
+-- também funciona (usa IF NOT EXISTS / CREATE OR REPLACE).
+--
+-- Pré-requisito: tabelas products, orders e order_items do marketplace
+-- (ou seja, o banco precisa estar na revisão 7e03d1bf5a42).
+--
+-- NÃO altera: users, stock_adjustments, products.description/color/price.
+--
+-- Tabelas criadas:
+--   staff_users      operadores do painel /estoque (login)
+--   staff_sessions   sessões de login (só o hash do token)
+--   stock_movements  livro-razão: quem comprou, quantas latas saíram e quando
+-- Trigger:
+--   trg_products_stock_ledger  registra TODA alteração de products.stock
+-- Views:
+--   vw_estoque_atual, vw_movimentacoes_estoque, vw_saidas_estoque
+--
+-- Gerado a partir de UPGRADE_STATEMENTS da migration; não edite à mão sem
+-- alterar a migration (tests/test_stock_schema_sql.py confere os dois).
+-- =====================================================================
+
+"""
+
+
+def main() -> None:
+    spec = importlib.util.spec_from_file_location("stock_ledger_migration", MIGRATION)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    body = "\n".join(statement.strip() + ";\n" for statement in module.UPGRADE_STATEMENTS)
+    OUTPUT.write_text(HEADER + "BEGIN;\n\n" + body + "\nCOMMIT;\n", encoding="utf-8")
+    print(f"{OUTPUT.relative_to(ROOT)} atualizado ({len(module.UPGRADE_STATEMENTS)} comandos).")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/sql/consultas_estoque.sql b/sql/consultas_estoque.sql
new file mode 100644
index 0000000..94f0035
--- /dev/null
+++ b/sql/consultas_estoque.sql
@@ -0,0 +1,126 @@
+-- =====================================================================
+-- Consultas de estoque (somente leitura) — Red Bull CITi
+-- Horários exibidos no fuso America/Recife.
+-- Rode trechos individuais no psql, DBeaver ou pgAdmin.
+-- =====================================================================
+
+-- 1) Estoque atual por sabor --------------------------------------------
+SELECT produto_id, sabor, categoria,
+       estoque_fisico, reservado_pix, disponivel_marketplace,
+       ultima_movimentacao AT TIME ZONE 'America/Recife' AS ultima_movimentacao
+  FROM vw_estoque_atual
+ ORDER BY categoria, sabor;
+
+
+-- Observação: vw_saidas_estoque traz toda redução de estoque. As consultas
+-- abaixo filtram por tipo para contar só saídas reais de latas (vendas e
+-- perdas); ajustes de inventário ficam de fora dos totais.
+
+-- 2) Saídas de hoje: quem comprou, quantas latas e a que horas -------------
+SELECT to_char(horario_recife, 'HH24:MI') AS hora,
+       sabor, quantidade, tipo_descricao, comprador, email_comprador,
+       valor_total, operador_nome, observacao, pedido_id
+  FROM vw_saidas_estoque
+ WHERE horario_recife >= date_trunc('day', now() AT TIME ZONE 'America/Recife')
+   AND tipo IN ('MARKETPLACE_SALE', 'MANUAL_SALE', 'LOSS')
+ ORDER BY horario_recife DESC;
+
+
+-- 3) Saídas em um período (ajuste as datas) ------------------------------
+SELECT horario_recife, sabor, quantidade, tipo_descricao, comprador,
+       email_comprador, preco_unitario, valor_total, operador_nome, observacao
+  FROM vw_saidas_estoque
+ WHERE horario_recife >= DATE '2026-10-01'
+   AND horario_recife <  DATE '2026-11-01'
+   AND tipo IN ('MARKETPLACE_SALE', 'MANUAL_SALE', 'LOSS')
+ ORDER BY horario_recife;
+
+
+-- 4) Sabores que mais saíram nos últimos 30 dias ------------------------
+SELECT sabor,
+       sum(quantidade)                                            AS latas,
+       sum(quantidade) FILTER (WHERE tipo = 'MARKETPLACE_SALE')   AS marketplace,
+       sum(quantidade) FILTER (WHERE tipo = 'MANUAL_SALE')        AS venda_manual,
+       sum(quantidade) FILTER (WHERE tipo = 'LOSS')               AS perdas,
+       sum(valor_total)                                           AS faturamento_marketplace
+  FROM vw_saidas_estoque
+ WHERE horario_utc >= now() - interval '30 days'
+   AND tipo IN ('MARKETPLACE_SALE', 'MANUAL_SALE', 'LOSS')
+ GROUP BY sabor
+ ORDER BY latas DESC;
+
+
+-- 5) Compras por pessoa (marketplace + venda manual) --------------------
+SELECT coalesce(email_comprador, lower(comprador))  AS comprador_chave,
+       max(comprador)                               AS comprador,
+       count(DISTINCT coalesce(pedido_id::text, id::text)) AS compras,
+       sum(quantidade)                              AS latas,
+       max(horario_recife)                          AS ultima_compra
+  FROM vw_saidas_estoque
+ WHERE tipo IN ('MARKETPLACE_SALE', 'MANUAL_SALE')
+ GROUP BY 1
+ ORDER BY latas DESC;
+
+
+-- 6) Saídas por dia ------------------------------------------------------
+SELECT horario_recife::date AS dia,
+       sum(quantidade) AS latas,
+       sum(quantidade) FILTER (WHERE tipo = 'MARKETPLACE_SALE') AS marketplace,
+       sum(quantidade) FILTER (WHERE tipo = 'MANUAL_SALE')      AS manual,
+       sum(quantidade) FILTER (WHERE tipo = 'LOSS')             AS perdas
+  FROM vw_saidas_estoque
+ WHERE tipo IN ('MARKETPLACE_SALE', 'MANUAL_SALE', 'LOSS')
+ GROUP BY 1
+ ORDER BY 1 DESC;
+
+
+-- 7) Lançamentos por operador do painel ----------------------------------
+SELECT operador_nome, tipo_descricao, count(*) AS lancamentos, sum(quantidade) AS latas
+  FROM vw_movimentacoes_estoque
+ WHERE origem = 'PAINEL'
+ GROUP BY operador_nome, tipo_descricao
+ ORDER BY operador_nome, tipo_descricao;
+
+
+-- 8) Alterações feitas fora do sistema (investigar) -----------------------
+-- Toda mudança em products.stock sem contexto da aplicação (ex.: UPDATE
+-- manual) aparece como UNTRACKED, com o usuário do banco que a executou.
+SELECT horario_recife, sabor, delta, estoque_antes, estoque_depois,
+       usuario_banco, observacao
+  FROM vw_movimentacoes_estoque
+ WHERE tipo = 'UNTRACKED'
+ ORDER BY horario_recife DESC;
+
+
+-- 9) Conferência de integridade: estoque x livro-razão --------------------
+-- Para cada sabor com histórico, o estoque_depois da última movimentação
+-- deve ser igual ao estoque atual. "diferenca" diferente de zero indica
+-- alteração que escapou do trigger (não deveria acontecer).
+SELECT p.id, p.name, p.stock AS estoque_atual,
+       ultima.stock_after AS estoque_no_razao,
+       p.stock - ultima.stock_after AS diferenca
+  FROM products AS p
+  JOIN LATERAL (
+        SELECT m.stock_after
+          FROM stock_movements AS m
+         WHERE m.product_id = p.id
+         ORDER BY m.id DESC
+         LIMIT 1
+  ) AS ultima ON true
+ ORDER BY abs(p.stock - ultima.stock_after) DESC, p.name;
+
+
+-- 10) Tabelas legadas do controle de estoque antigo ----------------------
+-- users e stock_adjustments vieram do sistema perdido e são preservadas.
+-- Existem só no banco institucional (numa instalação nova a 2ª consulta
+-- falha com "relation does not exist", o que é esperado).
+-- Use estas consultas para decidir se vale importar o histórico.
+SELECT table_name, column_name, data_type, is_nullable
+  FROM information_schema.columns
+ WHERE table_schema = current_schema()
+   AND table_name IN ('users', 'stock_adjustments')
+ ORDER BY table_name, ordinal_position;
+
+SELECT 'users' AS tabela, count(*) AS linhas FROM users
+UNION ALL
+SELECT 'stock_adjustments', count(*) FROM stock_adjustments;
diff --git a/sql/estoque_schema.sql b/sql/estoque_schema.sql
new file mode 100644
index 0000000..6daa09a
--- /dev/null
+++ b/sql/estoque_schema.sql
@@ -0,0 +1,330 @@
+-- =====================================================================
+-- Controle de estoque Red Bull CITi — modelo de dados (PostgreSQL 11+)
+--
+-- Mesmo conteúdo da revisão Alembic c3f8a1d27b54 (parte de 7e03d1bf5a42).
+-- Caminho recomendado:  alembic upgrade head
+-- Este arquivo existe para revisão, diagramas (DBeaver/pgAdmin) e para
+-- quem precisar aplicar o modelo manualmente. É idempotente: pode ser
+-- executado de novo sem erro, e o `alembic upgrade head` posterior
+-- também funciona (usa IF NOT EXISTS / CREATE OR REPLACE).
+--
+-- Pré-requisito: tabelas products, orders e order_items do marketplace
+-- (ou seja, o banco precisa estar na revisão 7e03d1bf5a42).
+--
+-- NÃO altera: users, stock_adjustments, products.description/color/price.
+--
+-- Tabelas criadas:
+--   staff_users      operadores do painel /estoque (login)
+--   staff_sessions   sessões de login (só o hash do token)
+--   stock_movements  livro-razão: quem comprou, quantas latas saíram e quando
+-- Trigger:
+--   trg_products_stock_ledger  registra TODA alteração de products.stock
+-- Views:
+--   vw_estoque_atual, vw_movimentacoes_estoque, vw_saidas_estoque
+--
+-- Gerado a partir de UPGRADE_STATEMENTS da migration; não edite à mão sem
+-- alterar a migration (tests/test_stock_schema_sql.py confere os dois).
+-- =====================================================================
+
+BEGIN;
+
+CREATE TABLE IF NOT EXISTS staff_users (
+    id                     BIGSERIAL    PRIMARY KEY,
+    username               VARCHAR(50)  NOT NULL,
+    full_name              VARCHAR(120) NOT NULL,
+    password_hash          VARCHAR(255) NOT NULL,
+    role                   VARCHAR(20)  NOT NULL DEFAULT 'OPERADOR',
+    active                 BOOLEAN      NOT NULL DEFAULT true,
+    failed_login_attempts  INTEGER      NOT NULL DEFAULT 0,
+    locked_until           TIMESTAMPTZ,
+    last_login_at          TIMESTAMPTZ,
+    created_at             TIMESTAMPTZ  NOT NULL DEFAULT now(),
+    updated_at             TIMESTAMPTZ  NOT NULL DEFAULT now(),
+    CONSTRAINT uq_staff_users_username UNIQUE (username),
+    CONSTRAINT ck_staff_users_role CHECK (role IN ('ADMIN', 'OPERADOR')),
+    CONSTRAINT ck_staff_users_username_format
+        CHECK (username ~ '^[a-z0-9._-]{3,50}$'),
+    CONSTRAINT ck_staff_users_failed_login_attempts
+        CHECK (failed_login_attempts >= 0)
+);
+
+COMMENT ON TABLE staff_users IS
+    'Operadores do painel de estoque. Senha guardada apenas como hash scrypt.';
+
+CREATE TABLE IF NOT EXISTS staff_sessions (
+    id             BIGSERIAL    PRIMARY KEY,
+    staff_user_id  BIGINT       NOT NULL,
+    token_hash     VARCHAR(64)  NOT NULL,
+    created_at     TIMESTAMPTZ  NOT NULL DEFAULT now(),
+    expires_at     TIMESTAMPTZ  NOT NULL,
+    revoked_at     TIMESTAMPTZ,
+    user_agent     VARCHAR(255),
+    ip_address     VARCHAR(45),
+    CONSTRAINT uq_staff_sessions_token_hash UNIQUE (token_hash),
+    CONSTRAINT fk_staff_sessions_staff_user_id
+        FOREIGN KEY (staff_user_id) REFERENCES staff_users (id) ON DELETE CASCADE
+);
+
+CREATE INDEX IF NOT EXISTS ix_staff_sessions_staff_user_id
+    ON staff_sessions (staff_user_id);
+
+COMMENT ON TABLE staff_sessions IS
+    'Sessões do painel de estoque. O token do cookie nunca é salvo, só o SHA-256.';
+
+CREATE TABLE IF NOT EXISTS stock_movements (
+    id                    BIGSERIAL      PRIMARY KEY,
+    product_id            VARCHAR(50)    NOT NULL,
+    product_name          VARCHAR(120)   NOT NULL,
+    movement_type         VARCHAR(30)    NOT NULL,
+    source                VARCHAR(20)    NOT NULL,
+    quantity              INTEGER        NOT NULL,
+    delta                 INTEGER        NOT NULL,
+    stock_before          INTEGER        NOT NULL,
+    stock_after           INTEGER        NOT NULL,
+    reserved_stock_after  INTEGER        NOT NULL,
+    order_id              UUID,
+    staff_user_id         BIGINT,
+    buyer_name            VARCHAR(80),
+    buyer_email           VARCHAR(254),
+    unit_price            NUMERIC(10, 2),
+    note                  VARCHAR(500),
+    db_user               VARCHAR(63)    NOT NULL DEFAULT session_user,
+    created_at            TIMESTAMPTZ    NOT NULL DEFAULT now(),
+    CONSTRAINT fk_stock_movements_product_id
+        FOREIGN KEY (product_id) REFERENCES products (id),
+    CONSTRAINT fk_stock_movements_order_id
+        FOREIGN KEY (order_id) REFERENCES orders (id) ON DELETE SET NULL,
+    CONSTRAINT fk_stock_movements_staff_user_id
+        FOREIGN KEY (staff_user_id) REFERENCES staff_users (id),
+    CONSTRAINT ck_stock_movements_type CHECK (
+        movement_type IN (
+            'INITIAL_STOCK', 'RESTOCK', 'MANUAL_SALE', 'LOSS',
+            'ADJUSTMENT', 'MARKETPLACE_SALE', 'UNTRACKED'
+        )
+    ),
+    CONSTRAINT ck_stock_movements_source
+        CHECK (source IN ('PAINEL', 'MARKETPLACE', 'BANCO')),
+    CONSTRAINT ck_stock_movements_quantity
+        CHECK (quantity > 0 AND quantity = abs(delta)),
+    CONSTRAINT ck_stock_movements_balance
+        CHECK (stock_after = stock_before + delta),
+    CONSTRAINT ck_stock_movements_direction CHECK (
+        (movement_type IN ('INITIAL_STOCK', 'RESTOCK') AND delta > 0)
+        OR (movement_type IN ('MANUAL_SALE', 'LOSS', 'MARKETPLACE_SALE') AND delta < 0)
+        OR movement_type IN ('ADJUSTMENT', 'UNTRACKED')
+    ),
+    CONSTRAINT ck_stock_movements_manual_sale_buyer
+        CHECK (movement_type <> 'MANUAL_SALE' OR buyer_name IS NOT NULL)
+);
+
+CREATE INDEX IF NOT EXISTS ix_stock_movements_product_id_created_at
+    ON stock_movements (product_id, created_at);
+
+CREATE INDEX IF NOT EXISTS ix_stock_movements_created_at
+    ON stock_movements (created_at);
+
+CREATE INDEX IF NOT EXISTS ix_stock_movements_order_id
+    ON stock_movements (order_id);
+
+CREATE INDEX IF NOT EXISTS ix_stock_movements_staff_user_id
+    ON stock_movements (staff_user_id);
+
+COMMENT ON TABLE stock_movements IS
+    'Livro-razão de estoque: uma linha por alteração de products.stock. Preenchido pelo trigger trg_products_stock_ledger.';
+
+CREATE OR REPLACE FUNCTION fn_stock_movements_ledger()
+RETURNS trigger
+LANGUAGE plpgsql
+SECURITY DEFINER
+AS $fn$
+DECLARE
+    v_raw          text;
+    v_ctx          jsonb := '{}'::jsonb;
+    v_before       integer;
+    v_delta        integer;
+    v_type         text;
+    v_source       text;
+    v_order_id     uuid;
+    v_staff_id     bigint;
+    v_buyer_name   text;
+    v_buyer_email  text;
+    v_unit_price   numeric(10, 2);
+    v_note         text;
+BEGIN
+    IF TG_OP = 'INSERT' THEN
+        v_before := 0;
+    ELSE
+        v_before := OLD.stock;
+    END IF;
+    v_delta := NEW.stock - v_before;
+    IF v_delta = 0 THEN
+        RETURN NEW;
+    END IF;
+
+    -- Cada parte do contexto é lida isoladamente: um campo ruim não apaga
+    -- os demais (principalmente o operador) e nunca aborta a transação.
+    BEGIN
+        v_raw := current_setting('redbull.stock_context', true);
+        IF v_raw IS NOT NULL AND btrim(v_raw) <> '' THEN
+            v_ctx := v_raw::jsonb;
+        END IF;
+    EXCEPTION WHEN others THEN
+        v_ctx := '{}'::jsonb;
+        v_note := '[contexto de estoque inválido ignorado]';
+    END;
+    IF jsonb_typeof(v_ctx) IS DISTINCT FROM 'object' THEN
+        v_ctx := '{}'::jsonb;
+    END IF;
+
+    v_type := v_ctx ->> 'movement_type';
+    v_source := v_ctx ->> 'source';
+    v_buyer_name := left(NULLIF(btrim(v_ctx ->> 'buyer_name'), ''), 80);
+    v_buyer_email := left(NULLIF(btrim(v_ctx ->> 'buyer_email'), ''), 254);
+    v_note := concat_ws(' ', v_note, NULLIF(btrim(v_ctx ->> 'note'), ''));
+    BEGIN
+        v_order_id := NULLIF(v_ctx ->> 'order_id', '')::uuid;
+    EXCEPTION WHEN others THEN
+        v_order_id := NULL;
+    END;
+    BEGIN
+        v_staff_id := NULLIF(v_ctx ->> 'staff_user_id', '')::bigint;
+    EXCEPTION WHEN others THEN
+        v_staff_id := NULL;
+    END;
+    BEGIN
+        v_unit_price := NULLIF(v_ctx ->> 'unit_price', '')::numeric(10, 2);
+    EXCEPTION WHEN others THEN
+        v_unit_price := NULL;
+    END;
+
+    IF v_type IS NULL THEN
+        v_type := CASE WHEN TG_OP = 'INSERT' THEN 'INITIAL_STOCK' ELSE 'UNTRACKED' END;
+    END IF;
+    IF v_source IS NULL OR v_source NOT IN ('PAINEL', 'MARKETPLACE', 'BANCO') THEN
+        v_source := 'BANCO';
+    END IF;
+
+    IF NOT (
+        (v_type IN ('INITIAL_STOCK', 'RESTOCK') AND v_delta > 0)
+        OR (v_type IN ('MANUAL_SALE', 'LOSS', 'MARKETPLACE_SALE') AND v_delta < 0)
+        OR v_type IN ('ADJUSTMENT', 'UNTRACKED')
+    ) OR (v_type = 'MANUAL_SALE' AND v_buyer_name IS NULL) THEN
+        v_note := concat_ws(' ', '[tipo ' || left(v_type, 40) || ' incompatível com a alteração]', v_note);
+        v_type := 'UNTRACKED';
+    END IF;
+
+    IF v_order_id IS NOT NULL THEN
+        SELECT COALESCE(v_buyer_name, left(o.buyer_name, 80)),
+               COALESCE(v_buyer_email, left(o.payer_email, 254))
+          INTO v_buyer_name, v_buyer_email
+          FROM orders AS o
+         WHERE o.id = v_order_id;
+        IF NOT FOUND THEN
+            v_order_id := NULL;
+        ELSE
+            SELECT COALESCE(v_unit_price, max(item.unit_price))
+              INTO v_unit_price
+              FROM order_items AS item
+             WHERE item.order_id = v_order_id
+               AND item.product_id = NEW.id;
+        END IF;
+    END IF;
+
+    IF v_staff_id IS NOT NULL
+       AND NOT EXISTS (SELECT 1 FROM staff_users WHERE id = v_staff_id) THEN
+        v_staff_id := NULL;
+    END IF;
+
+    INSERT INTO stock_movements (
+        product_id, product_name, movement_type, source,
+        quantity, delta, stock_before, stock_after, reserved_stock_after,
+        order_id, staff_user_id, buyer_name, buyer_email, unit_price, note, db_user
+    ) VALUES (
+        NEW.id, left(NEW.name, 120), v_type, v_source,
+        abs(v_delta), v_delta, v_before, NEW.stock, NEW.reserved_stock,
+        v_order_id, v_staff_id, v_buyer_name, v_buyer_email, v_unit_price,
+        left(NULLIF(v_note, ''), 500), left(session_user, 63)
+    );
+    RETURN NEW;
+END;
+$fn$;
+
+DO $sp$
+BEGIN
+    EXECUTE format(
+        'ALTER FUNCTION fn_stock_movements_ledger() SET search_path = %I, pg_temp',
+        current_schema()
+    );
+END
+$sp$;
+
+REVOKE ALL ON FUNCTION fn_stock_movements_ledger() FROM PUBLIC;
+
+DROP TRIGGER IF EXISTS trg_products_stock_ledger ON products;
+
+CREATE TRIGGER trg_products_stock_ledger
+    AFTER INSERT OR UPDATE OF stock ON products
+    FOR EACH ROW
+    EXECUTE FUNCTION fn_stock_movements_ledger();
+
+CREATE OR REPLACE VIEW vw_estoque_atual AS
+SELECT
+    p.id                         AS produto_id,
+    p.name                       AS sabor,
+    p.category                   AS categoria,
+    p.stock                      AS estoque_fisico,
+    p.reserved_stock             AS reservado_pix,
+    p.stock - p.reserved_stock   AS disponivel_marketplace,
+    ultima.created_at            AS ultima_movimentacao
+FROM products AS p
+LEFT JOIN LATERAL (
+    SELECT m.created_at
+      FROM stock_movements AS m
+     WHERE m.product_id = p.id
+     ORDER BY m.created_at DESC, m.id DESC
+     LIMIT 1
+) AS ultima ON true;
+
+CREATE OR REPLACE VIEW vw_movimentacoes_estoque AS
+SELECT
+    m.id,
+    m.created_at                                  AS horario_utc,
+    (m.created_at AT TIME ZONE 'America/Recife')  AS horario_recife,
+    m.product_id                                  AS produto_id,
+    m.product_name                                AS sabor,
+    m.movement_type                               AS tipo,
+    CASE m.movement_type
+        WHEN 'INITIAL_STOCK'    THEN 'Estoque inicial'
+        WHEN 'RESTOCK'          THEN 'Reposição'
+        WHEN 'MANUAL_SALE'      THEN 'Venda manual'
+        WHEN 'LOSS'             THEN 'Perda/avaria'
+        WHEN 'ADJUSTMENT'       THEN 'Ajuste de inventário'
+        WHEN 'MARKETPLACE_SALE' THEN 'Venda no marketplace'
+        ELSE 'Alteração sem contexto'
+    END                                           AS tipo_descricao,
+    m.source                                      AS origem,
+    CASE WHEN m.delta < 0 THEN 'SAIDA' ELSE 'ENTRADA' END AS direcao,
+    m.quantity                                    AS quantidade,
+    m.delta,
+    m.stock_before                                AS estoque_antes,
+    m.stock_after                                 AS estoque_depois,
+    m.buyer_name                                  AS comprador,
+    m.buyer_email                                 AS email_comprador,
+    m.order_id                                    AS pedido_id,
+    o.paid_at                                     AS pago_em,
+    m.unit_price                                  AS preco_unitario,
+    m.unit_price * m.quantity                     AS valor_total,
+    su.username                                   AS operador_usuario,
+    su.full_name                                  AS operador_nome,
+    m.note                                        AS observacao,
+    m.db_user                                     AS usuario_banco
+FROM stock_movements AS m
+LEFT JOIN orders AS o ON o.id = m.order_id
+LEFT JOIN staff_users AS su ON su.id = m.staff_user_id;
+
+CREATE OR REPLACE VIEW vw_saidas_estoque AS
+SELECT *
+  FROM vw_movimentacoes_estoque
+ WHERE delta < 0;
+
+COMMIT;
diff --git a/sql/seed_sabores.sql b/sql/seed_sabores.sql
new file mode 100644
index 0000000..6540dee
--- /dev/null
+++ b/sql/seed_sabores.sql
@@ -0,0 +1,92 @@
+-- =====================================================================
+-- Catálogo de sabores Red Bull do marketplace CITi (OPCIONAL)
+--
+-- Cadastra os 12 sabores que o PDV já sabe exibir (imagens em
+-- app/static/assets). Rode só depois de `alembic upgrade head`.
+--
+-- Seguro para rodar mais de uma vez e no banco institucional:
+--   * não altera sabores existentes (nem estoque, nem nome);
+--   * pula o sabor se já existir um produto com o mesmo id OU com o
+--     mesmo nome normalizado (sem acento/maiúsculas/espaços), evitando
+--     duplicar um sabor cadastrado com outro id;
+--   * todos entram com estoque 0 — use o painel /estoque (botão
+--     "+ Entrada") para lançar as latas, assim a entrada fica registrada
+--     com o operador responsável;
+--   * funciona com ou sem as colunas legadas products.description,
+--     products.color e products.price.
+--
+-- Uso: psql "$DATABASE_URL_SEM_ASYNCPG" -f sql/seed_sabores.sql
+-- =====================================================================
+
+BEGIN;
+
+DO $seed$
+DECLARE
+    v_has_legacy boolean;
+    v_flavor     record;
+    v_inserted   integer := 0;
+    v_skipped    integer := 0;
+BEGIN
+    SELECT count(*) = 3
+      INTO v_has_legacy
+      FROM information_schema.columns
+     WHERE table_schema = current_schema()
+       AND table_name = 'products'
+       AND column_name IN ('description', 'color', 'price');
+
+    FOR v_flavor IN
+        SELECT *
+          FROM (VALUES
+            ('original',              'Energy Original',        'Regular',   'O clássico que dá asas.',          '#164194'),
+            ('tropical',              'Tropical',               'Regular',   'Sabor tropical e refrescante.',    '#f5c400'),
+            ('melancia',              'Melancia',               'Regular',   'Leve, frutado e marcante.',        '#e7354f'),
+            ('nectarina',             'Nectarina',              'Regular',   'Edição de verão de nectarina.',    '#f28c28'),
+            ('melao_e_maracuja',      'Melão e Maracujá',       'Regular',   'Melão com maracujá.',              '#7cc242'),
+            ('morango_e_pessego',     'Morango e Pêssego',      'Regular',   'Morango com pêssego.',             '#e8506e'),
+            ('zero_tradicional',      'Tradicional Zero',       'Zero',      'Zero açúcar e zero calorias.',     '#9aa3ad'),
+            ('tradicional_sugarfree', 'Tradicional Sugarfree',  'Sugarfree', 'Sem açúcar.',                      '#4fb3e8'),
+            ('nectarina_sugarfree',   'Nectarina Sugarfree',    'Sugarfree', 'Nectarina sem açúcar.',            '#f5a25d'),
+            ('pomelo_sugarfree',      'Pomelo Sugarfree',       'Sugarfree', 'Pomelo sem açúcar.',               '#f07c8c'),
+            ('amora_sugarfree',       'Amora Sugarfree',        'Sugarfree', 'Amora sem açúcar.',                '#7b4fa0'),
+            ('maca_sugarfree',        'Maçã Sugarfree',         'Sugarfree', 'Maçã sem açúcar.',                 '#8cc63f')
+          ) AS f(id, name, category, description, color)
+    LOOP
+        IF EXISTS (
+            SELECT 1
+              FROM products AS p
+             WHERE p.id = v_flavor.id
+                OR regexp_replace(
+                       lower(translate(p.name, 'áàâãäéèêëíìîïóòôõöúùûüçÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇ',
+                                               'aaaaaeeeeiiiiooooouuuucaaaaaeeeeiiiiooooouuuuc')),
+                       '[^a-z0-9]+', '', 'g')
+                 = regexp_replace(
+                       lower(translate(v_flavor.name, 'áàâãäéèêëíìîïóòôõöúùûüçÁÀÂÃÄÉÈÊËÍÌÎÏÓÒÔÕÖÚÙÛÜÇ',
+                                                      'aaaaaeeeeiiiiooooouuuucaaaaaeeeeiiiiooooouuuuc')),
+                       '[^a-z0-9]+', '', 'g')
+        ) THEN
+            v_skipped := v_skipped + 1;
+            CONTINUE;
+        END IF;
+
+        IF v_has_legacy THEN
+            -- Instalações criadas do zero ainda têm as colunas legadas NOT NULL.
+            INSERT INTO products (id, name, category, stock, reserved_stock, description, color, price)
+            VALUES (v_flavor.id, v_flavor.name, v_flavor.category, 0, 0,
+                    v_flavor.description, v_flavor.color, 8.50);
+        ELSE
+            INSERT INTO products (id, name, category, stock, reserved_stock)
+            VALUES (v_flavor.id, v_flavor.name, v_flavor.category, 0, 0);
+        END IF;
+        v_inserted := v_inserted + 1;
+    END LOOP;
+
+    RAISE NOTICE 'Sabores cadastrados: %, já existentes (ignorados): %', v_inserted, v_skipped;
+END
+$seed$;
+
+COMMIT;
+
+-- Conferência
+SELECT produto_id, sabor, categoria, estoque_fisico, disponivel_marketplace
+  FROM vw_estoque_atual
+ ORDER BY categoria, sabor;
