DATABASE_URL=postgresql+asyncpg://redbull:redbull@localhost:5432/redbull
TEST_DATABASE_URL=postgresql+asyncpg://redbull:redbull@localhost:5433/redbull_test
# Valores válidos: mock ou mercadopago. A variável deve ser explícita.
PAYMENT_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Uso exclusivo de teste; não configurar em produção.
MERCADOPAGO_TEST_PAYER_FIRST_NAME=
MERCADOPAGO_TEST_PAYER_EMAIL=
CHARGE_EXPIRES_IN=1800
# Tempo da tela/reserva local (10 minutos). O Mercado Pago exige ao menos 30 minutos.
PAYMENT_CHECKOUT_EXPIRES_IN=600
PAYMENT_EXPIRATION_CHECK_INTERVAL=5
