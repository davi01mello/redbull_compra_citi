# mock: demonstração | static_pix: chave PIX real sem webhook | openpix: Woovi
PAYMENT_PROVIDER=mock
OPENPIX_ENVIRONMENT=sandbox
OPENPIX_APP_ID=
OPENPIX_WEBHOOK_SECRET=

# Usado somente com PAYMENT_PROVIDER=static_pix
PIX_KEY=
PIX_RECEIVER_NAME=
PIX_RECEIVER_CITY=Fortaleza

# SQLite local. No Render, use a URL do PostgreSQL.
DATABASE_URL=sqlite:///./redbull.db
CHARGE_EXPIRES_IN=600
